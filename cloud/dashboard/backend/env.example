# Rename to .env.example (and then to .env for local runs) — written
# without the leading dot here because this environment's permission
# rules block writing .env*-named files directly.

# Postgres — Railway's Postgres plugin provides DATABASE_URL automatically
# when attached to this service; set it manually for local runs.
DATABASE_URL=postgresql://user:pass@localhost:5432/plc

# MQTT broker connection (cloud/broker, deployed separately).
MQTT_URL=mqtts://your-broker-app.up.railway.app:1884
MQTT_OUTPUT_TOPIC=plant/small_scope/output/state
MQTT_INPUT_TOPIC=plant/small_scope/input/state

# Broker auth: TLS + device-token (defense in depth, not TLS-only) —
# matches cloud/broker's check_device_token(email, token), sent as the
# MQTT CONNECT username/password fields. Issue these via this backend's
# own POST /api/admin/devices (see README.md "Device token issuance"),
# not the Paint-mixer-era GET /api/auth/device-token, which doesn't
# exist in this service.
MQTT_USERNAME=your-account-email@example.com
MQTT_DEVICE_TOKEN=issued-by-POST-/api/admin/devices

# Second, SEPARATE Postgres connection used ONLY by POST /api/admin/devices
# to issue device tokens — this must point at cloud/broker's own dedicated
# Postgres (its DATABASE_URL), NOT this service's DATABASE_URL above. The
# two databases stay intentionally separate; see README.md and
# cloud/broker/README.md "Device token issuance".
BROKER_DATABASE_URL=postgresql://broker:broker@localhost:5432/broker

# Broker cert is self-signed (not CA-issued) — point this at a saved copy
# of that exact cert so paho trusts it specifically. Omitting it falls
# back to no cert validation at all (logged as a warning) — lab/POC only.
MQTT_TLS_CA_CERT=/path/to/broker-self-signed-cert.pem

# Dashboard REST API auth (separate from the MQTT connection above).
JWT_SECRET=change-me-to-a-long-random-value
DASHBOARD_ADMIN_USER=admin
# Generate with: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
DASHBOARD_ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-real-bcrypt-hash
