# Rename to .env.example (and then to .env for local runs) — written
# without the leading dot here because this environment's permission
# rules block writing .env*-named files directly.

# Postgres holding the User table with the deviceToken column that
# check_device_token() reads. Must point at whichever service actually
# issues/stores device tokens — not decided/wired up yet in this repo.
DATABASE_URL=postgresql://user:pass@localhost:5432/plc

# Port the MQTT listener binds to. Exposed via Railway's TCP Proxy
# (configured in the Railway dashboard, not here).
MQTT_PORT=1883

# Port uvicorn's own HTTP server (GET /health) binds to. On a service
# that also has a Railway TCP Proxy, Railway's injected $PORT tracks
# the TCP Proxy's target port (MQTT_PORT above), NOT the HTTP domain's
# — so the Dockerfile binds this fixed HTTP_PORT instead of $PORT, to
# avoid uvicorn and the MQTT listener both trying to bind the same
# port in the same process. Must match Settings → Networking → Public
# Networking → Target port on Railway.
HTTP_PORT=8080

# TLS for the MQTT listener — self-signed cert, trusted manually by
# clients (not CA-issued, intentional). Omit both to run plaintext
# (local/dev only). Each value is EITHER a path to a PEM file (what
# scripts/generate_broker_cert.py writes, for local runs) OR the PEM
# content itself (what a cloud host with no shared filesystem, e.g.
# Railway, needs — build_ssl_context() auto-detects which).
MQTT_TLS_CERT=/path/to/broker-self-signed-cert.pem
MQTT_TLS_KEY=/path/to/broker-self-signed-key.pem

# Topic ACL (see broker.py): every topic a client may PUBLISH/SUBSCRIBE
# to must start with this prefix; a topic ending in MQTT_COMMAND_SUFFIX
# additionally requires the connecting User.canCommand=true. Defaults
# match this repo's only known topics (edge/small_scope/config.js).
MQTT_TOPIC_PREFIX=plant/
MQTT_COMMAND_SUFFIX=/command
