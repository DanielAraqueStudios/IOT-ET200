# Rename to .env.example (and then to .env for local runs) — written
# without the leading dot here because this environment's permission
# rules block writing .env*-named files directly.

# Postgres holding the User table with the deviceToken column that
# check_device_token() reads. Must point at whichever service actually
# issues/stores device tokens — not decided/wired up yet in this repo.
DATABASE_URL=postgresql://user:pass@localhost:5432/plc

# Port the MQTT listener binds to. Exposed via Railway's TCP Proxy
# (configured in the Railway dashboard, not here) — not the same as
# Railway's injected $PORT, which only serves /health.
MQTT_PORT=1883

# TLS for the MQTT listener — self-signed cert, trusted manually by
# clients (not CA-issued, intentional). Omit both to run plaintext
# (local/dev only).
MQTT_TLS_CERT=/path/to/broker-self-signed-cert.pem
MQTT_TLS_KEY=/path/to/broker-self-signed-key.pem
