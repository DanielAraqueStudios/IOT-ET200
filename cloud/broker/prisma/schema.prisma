// Prisma is used here ONLY for schema/migrations against the broker's
// dedicated Postgres — NOT as the runtime client. The running service
// stays Python/SQLAlchemy (see auth.py, models.py); this schema must be
// kept in sync with models.py by hand. See README.md "Database
// migrations" for why.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  // Bcrypt hash of the device token, never the plaintext value.
  deviceToken  String?
  // Topic ACL: only true for identities allowed to PUBLISH to a
  // "/command" topic (see cloud/broker/broker.py).
  canCommand   Boolean  @default(false)
  // Remote kill-switch: when false, check_device_token() rejects this
  // device's MQTT credentials outright, without re-issuing/rotating the
  // token. Lets an admin instantly cut off a compromised or retired
  // device (see cloud/dashboard/backend's PATCH /api/admin/devices/{email}).
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("User")
}
