# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local

# Claude Code / Ruflo tooling — local only, never checked in
.claude/
.claude-flow/
.swarm/
CLAUDE.md

# Dependencies
node_modules/
__pycache__/

# Angular CLI build cache (cloud/dashboard/frontend) — can go stale after
# an interrupted/corrupted npm install and silently serve an outdated
# compiled template even though the TS source is current; never commit it.
.angular/

# Generated by scripts/run_local_stack.py (TLS cert for the local dev stack)
scripts/.local-stack/

# Generated by scripts/generate_broker_cert.py (TLS cert for a deployed broker)
scripts/.broker-cert/
